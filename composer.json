{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "frolaxhq/bedrock",
  "description": "A capability-driven application foundation for Laravel.",
  "keywords": [
    "laravel",
    "frolaxhq",
    "bedrock"
  ],
  "homepage": "https://github.com/frolaxhq/bedrock",
  "license": "MIT",
  "authors": [
    {
      "name": "Bishwajit Adhikary",
      "email": "bishwajitcadhikary@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "composer/semver": "^3.4",
    "illuminate/cache": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/filesystem": "^13.0",
    "illuminate/support": "^13.0",
    "inertiajs/inertia-laravel": "^3.0",
    "spatie/laravel-data": "^4.23",
    "spatie/laravel-permission": "^8.0",
    "symfony/process": "^8.0"
  },
  "require-dev": {
    "jetbrains/phpstorm-attributes": "^1.3",
    "larastan/larastan": "^3.9",
    "laravel/pao": "^1.0",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.6||^5.0",
    "pestphp/pest-plugin-laravel": "^4.1||^5.0",
    "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
    "phpstan/extension-installer": "^1.4",
    "spatie/laravel-ray": "^1.43"
  },
  "autoload": {
    "psr-4": {
      "Frolax\\Bedrock\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Frolax\\Bedrock\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse"
    ],
    "test:types": [
      "vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Frolax\\Bedrock\\BedrockServiceProvider"
      ],
      "aliases": {
        "Frontend": "Frolax\\Bedrock\\Facades\\Frontend",
        "Module": "Frolax\\Bedrock\\Facades\\Module",
        "Settings": "Frolax\\Bedrock\\Facades\\Settings",
        "Permissions": "Frolax\\Bedrock\\Facades\\Permissions",
        "Navigation": "Frolax\\Bedrock\\Facades\\Navigation",
        "Administration": "Frolax\\Bedrock\\Facades\\Administration"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
