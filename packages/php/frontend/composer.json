{
    "name": "frolaxhq/bedrock-frontend",
    "description": "Optional Inertia and frontend artifact integration for Bedrock.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "frolaxhq/bedrock": "^1.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "autoload": { "psr-4": { "Frolax\\Bedrock\\": "src/" } },
    "extra": { "laravel": {
        "providers": ["Frolax\\Bedrock\\Providers\\FrontendServiceProvider"],
        "aliases": { "Frontend": "Frolax\\Bedrock\\Facades\\Frontend", "Navigation": "Frolax\\Bedrock\\Facades\\Navigation" }
    } }
}
