{
    "name": "frolaxhq/bedrock-workbench",
    "description": "Workbench host application for frolaxhq/bedrock",
    "type": "project",
    "license": "MIT",
    "private": true,
    "require": {},
    "autoload": {
        "psr-4": {
            "Workbench\\App\\": "app/",
            "Workbench\\Database\\Factories\\": "database/factories/",
