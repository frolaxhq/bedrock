{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@frolax/bedrock/lib": ["./src/ui/lib.ts"],
            "@frolax/bedrock/primitives": ["./src/ui/primitives.ts"],
            "@frolax/bedrock/theme": ["./src/ui/theme/index.tsx"],
            "@frolax/bedrock/ui": ["./src/ui/index.tsx"],
            "@frolax/bedrock/ui-runtime": ["./src/ui/runtime.ts"],
            "@frolax/bedrock/components": ["./src/defaults/components"],
            "@frolax/bedrock/components/*": ["./src/defaults/components/*.tsx"],
            "@frolax/bedrock/hooks": ["./src/defaults/hooks"],
            "@frolax/bedrock/hooks/*": ["./src/defaults/hooks/*.ts"],
            "@bedrock/components": ["./src/defaults/components"],
            "@bedrock/components/*": ["./src/defaults/components/*.tsx"],
            "@bedrock/hooks": ["./src/defaults/hooks"],
            "@bedrock/hooks/*": ["./src/defaults/hooks/*.ts"],
            "@bedrock/lib": ["./src/ui/lib.ts"],
            "@bedrock/lib/*": ["./src/ui/lib.ts"],
            "@bedrock/panel": ["./src/ui/panel/index.tsx"],
            "@bedrock/react": ["./src/runtime/types.ts"]
        },
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "types": ["node", "vite-plus/client", "vite-plus/test/globals"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "e2e/**/*.ts",
        "e2e/**/*.tsx"
    ]
}
