{
    "name": "@frolax/bedrock",
    "version": "1.0.0",
    "description": "Typed React, Inertia, and Vite+ runtime for Frolax Bedrock modules.",
    "license": "MIT",
    "bin": {
        "bedrock-artifact": "./bin/bedrock-artifact.mjs"
    },
    "files": [
        "dist",
        "bin",
        "catalog.json"
    ],
    "type": "module",
    "exports": {
        "./react": {
            "types": "./dist/runtime/react.d.ts",
            "import": "./dist/runtime/react.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "import": "./dist/vite/index.js"
        },
        "./module": {
            "types": "./dist/module/index.d.ts",
            "import": "./dist/module/index.js"
        },
        "./ui": {
            "types": "./dist/ui/index.d.ts",
            "import": "./dist/ui/index.js"
        },
        "./ui-runtime": {
            "types": "./dist/ui/runtime.d.ts",
            "import": "./dist/ui/runtime.js"
        },
        "./lib": {
            "types": "./dist/ui/lib.d.ts",
            "import": "./dist/ui/lib.js"
        },
        "./primitives": {
            "types": "./dist/ui/primitives.d.ts",
            "import": "./dist/ui/primitives.js"
        },
        "./theme": {
            "types": "./dist/ui/theme/index.d.ts",
            "import": "./dist/ui/theme/index.js"
        },
        "./theme.css": "./dist/ui/theme/theme.css",
        "./components/ui/*": {
            "types": "./dist/ui/index.d.ts",
            "import": "./dist/ui/index.js"
        },
        "./components/*": {
            "types": "./dist/ui/index.d.ts",
            "import": "./dist/ui/index.js"
        },
        "./layouts/*": {
            "types": "./dist/ui/index.d.ts",
            "import": "./dist/ui/index.js"
        },
        "./hooks/*": {
            "types": "./dist/ui/theme/index.d.ts",
            "import": "./dist/ui/theme/index.js"
        }
    },
    "scripts": {
        "generate": "node scripts/generate-frontend.mjs",
        "generate:check": "node scripts/generate-frontend.mjs --check",
        "build": "node scripts/generate-frontend.mjs && vp pack && node scripts/copy-assets.mjs",
        "check": "vp check",
        "test": "vp run generate:check && vp test run",
        "test:e2e": "vp run build && node e2e/prepare.mjs && playwright test"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@module-federation/enhanced": "2.9.2",
        "@module-federation/vite": "1.23.2",
        "@tabler/icons-react": "^3.49.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.2",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "next-themes": "^0.4.6",
        "semver": "^7.8.5",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@inertiajs/core": "3.8.0",
        "@inertiajs/react": "3.8.0",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "jsdom": "^27.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwindcss": "4.3.3",
        "typescript": "^5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@inertiajs/core": "^3.0.0",
        "@inertiajs/react": "^3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vite-plus": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "tailwindcss": {
            "optional": true
        }
    },
    "engines": {
        "node": "^24.11.0"
    }
}
